# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# Anthropic API key (for agent execution in Phase 5)
ANTHROPIC_API_KEY=

# OpenAI API key (optional, for GPT models)
OPENAI_API_KEY=

# Provider mode: auto, openai, anthropic, or ollama
LLM_PROVIDER=ollama

# Local fallback for air-gapped or quota-limited workstations
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Default model to use when creating new agent nodes
DEFAULT_MODEL=claude-sonnet-4-6
