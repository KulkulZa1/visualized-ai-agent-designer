# Harness Studio does not load .env files. Set these as OS (or launching-process)
# environment variables before starting the app. NEVER commit real key values.

# Anthropic API key (for agent execution in Phase 5)
ANTHROPIC_API_KEY=

# OpenAI API key (optional, for GPT models)
OPENAI_API_KEY=

# Provider mode: auto, openai, anthropic, ollama, ollama-cloud, or openai-compatible
# (the Custom endpoint — its URL/model are set in Settings). Used only while the
# in-app provider mode in Settings is Auto.
LLM_PROVIDER=ollama

# Local fallback for air-gapped or quota-limited workstations.
# NOTE: the desktop app currently ignores these two — the Ollama URL and model in
# Settings (default http://localhost:11434 / qwen2.5-coder:7b) always win. Set them there.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Ollama Cloud / authenticated remote Ollama
# Use LLM_PROVIDER=ollama-cloud and OLLAMA_BASE_URL=https://ollama.com/api
# Cloud default model: gemma4:31b-cloud. The alias gemma4-31b:cloud is accepted.
# Use OLLAMA_REMOTE_API_KEY only for private non-local Ollama gateways.
# Never commit real key values.
OLLAMA_API_KEY=
OLLAMA_REMOTE_API_KEY=

# Unused: DEFAULT_MODEL is not read by the app. Set each node's model in its Role tab.
# DEFAULT_MODEL=claude-sonnet-4-6
