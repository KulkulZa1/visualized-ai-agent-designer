{
  "name": "harness-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:ts": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "tsc --noEmit && vitest run",
    "build": "tsc && vite build",
    "build:core": "cargo build --release --manifest-path src-tauri/Cargo.toml --no-default-features --features core --bin harness-core",
    "build:cli": "vite build --config vite.cli.config.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "harness": "node cli/harness.mjs",
    "mcp": "node mcp/server.mjs",
    "build:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "build:installer:offline": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Offline",
    "build:dev-installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Dev",
    "build:dev-installer:offline": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1 -Dev -Offline"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.10.2",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "immer": "^11.1.8",
    "lucide-react": "^1.14.0",
    "monaco-editor": "^0.55.1",
    "postcss": "^8.5.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.2.4",
    "yaml": "^2.8.4",
    "zod": "^4.4.3",
    "zundo": "^2.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.5"
  }
}
