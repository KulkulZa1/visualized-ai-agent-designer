{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Studio",
  "version": "0.1.0",
  "identifier": "com.kulkulza.harness-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Harness Studio",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:11434 https://api.openai.com https://api.anthropic.com https://ollama.com https://api.ollama.com https://openrouter.ai; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:;",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "KulkulZa",
    "homepage": "https://github.com/KulkulZa",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "Harness Studio",
        "installerHooks": "nsis/installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "d3a7b25e-1f4c-4e98-b9d2-6a8f0e1c3d57"
      }
    }
  }
}
