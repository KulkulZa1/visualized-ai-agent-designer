# =====================================================
# Secrets and credentials — NEVER commit these
# =====================================================
.env
.env.*
!.env.example
*secrets*
*secret.*
api-keys.*
*.key
*.pem
*.p12

# =====================================================
# Audit and operational data
# =====================================================
# Root workspace runtime data
.harness/audit.log.jsonl
.harness/trajectories/
.harness/snapshots/
.harness/artifacts/
.agent-audit/
audit-log.db
audit-log.db-shm
audit-log.db-wal
# Any nested workspace runtime data (e.g. Run_test/.harness/)
**/.harness/audit.log.jsonl
**/.harness/trajectories/
**/.harness/snapshots/
**/.harness/artifacts/

# =====================================================
# Node.js
# =====================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

